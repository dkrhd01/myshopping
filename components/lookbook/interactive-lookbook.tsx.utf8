  // ?�래�??�들??(?�시�??�래�?
  useEffect(() => {
    if (!editMode || !draggedProduct) return;

    const handleMouseMove = (e: MouseEvent) => {
      if (!containerRef.current || !draggedProduct) return;

      const rect = containerRef.current.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;

      // 경계 체크 (0-100% 범위 ??
      const clampedX = Math.max(0, Math.min(100, x));
      const clampedY = Math.max(0, Math.min(100, y));

      setTempPositions((prev) => ({
        ...prev,
        [draggedProduct]: { x: clampedX, y: clampedY },
      }));
    };

    const handleMouseUp = () => {
      if (!draggedProduct) return;

      const product = products.find((p) => p.id === draggedProduct);
      const pos = tempPositions[draggedProduct];

      if (product && pos) {
        console.group("?�� ?�품 ?�치 ?�데?�트 SQL");
        console.log(`?�품: ${product.name}`);
        console.log(`???�치: X=${pos.x.toFixed(2)}%, Y=${pos.y.toFixed(2)}%`);
        console.log("\n?�래 SQL??Supabase?�서 ?�행?�세??\n");
        console.log(`UPDATE public.lookbook_items li
SET position_x = ${pos.x.toFixed(2)}, position_y = ${pos.y.toFixed(2)}
FROM public.lookbooks lb, public.products p
WHERE li.lookbook_id = lb.id 
  AND li.product_id = p.id
  AND lb.id = '${lookbookId}'
  AND p.slug = '${product.slug}';`);
        console.groupEnd();
      }

      setDraggedProduct(null);
    };

    // ?�역 ?�벤??리스???�록
    document.addEventListener("mousemove", handleMouseMove);
    document.addEventListener("mouseup", handleMouseUp);

    return () => {
      document.removeEventListener("mousemove", handleMouseMove);
      document.removeEventListener("mouseup", handleMouseUp);
    };
  }, [editMode, draggedProduct, products, tempPositions]);

  // ?�보???�살?�로 ?�택???�역 미세 ?�동 (?�집 모드?�서�?
  useEffect(() => {
    if (!editMode || !selectedProductId) return;

    const step = 0.5; // 0.5% ?�위 ?�동
    const handleKey = (e: KeyboardEvent) => {
      let dx = 0;
      let dy = 0;
      if (e.key === "ArrowUp") dy = -step;
      if (e.key === "ArrowDown") dy = step;
      if (e.key === "ArrowLeft") dx = -step;
      if (e.key === "ArrowRight") dx = step;
      if (dx === 0 && dy === 0) return;
      e.preventDefault();

      setTempPositions((prev) => {
        const base = (() => {
          const p = products.find((pp) => pp.id === selectedProductId);
          if (p) return { x: p.position_x, y: p.position_y };
          return { x: 50, y: 50 };
        })();
        const curr = prev[selectedProductId] || base;
        return {
          ...prev,
          [selectedProductId]: {
            x: Math.max(0, Math.min(100, curr.x + dx)),
            y: Math.max(0, Math.min(100, curr.y + dy)),
          },
        };
      });
    };

    window.addEventListener("keydown", handleKey);
    return () => window.removeEventListener("keydown", handleKey);
  }, [editMode, selectedProductId, products]);

  const handleDragStart = (productId: string) => {
    // ?�택???�품�??�래�?가??    if (!editMode || shapeEditMode || selectedProductId !== productId) return;
    setDraggedProduct(productId);
  };
  
  // ?�품 ?�택
  const handleSelectProduct = (productId: string) => {
    setSelectedProductId(productId);
  };
  
  // ?�품 ?�택 ?�료
  const handleCompleteSelection = () => {
    setSelectedProductId(null);
  };

  // ?�역 ?�집 모드 ?�작
  const startShapeEdit = (productId: string) => {
    setShapeEditMode(productId);
    setShapePoints([]);
    setIsDrawing(false);
    setEditMode(false); // ?�치 ?�집 모드 비활?�화
  };

  // ?�래�??�작 (마우???�운)
  const startDrawing = (e: React.MouseEvent) => {
    if (!shapeEditMode || !containerRef.current) return;

    setIsDrawing(true);
    const rect = containerRef.current.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;

    setShapePoints([{ x, y }]);
  };

  // ?�래�?�?(마우??무브)
  const continueDrawing = (e: React.MouseEvent) => {
    if (!shapeEditMode || !isDrawing || !containerRef.current) return;

    const rect = containerRef.current.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;

    // ?�전 ?�과??거리가 충분??멀 ?�만 추�? (?�능 최적??
    setShapePoints((prev) => {
      if (prev.length === 0) return [{ x, y }];

      const lastPoint = prev[prev.length - 1];
      const distance = Math.sqrt(
        Math.pow(x - lastPoint.x, 2) + Math.pow(y - lastPoint.y, 2),
      );

      // 거리가 0.5% ?�상???�만 ??추�?
      if (distance > 0.5) {
        return [...prev, { x, y }];
      }
      return prev;
    });
  };

  // ?�래�?종료 (마우????
  const stopDrawing = () => {
    if (!shapeEditMode) return;
    setIsDrawing(false);
  };

  // ?�역 ?�집 ?�료
  const finishShapeEdit = async () => {
    if (!shapeEditMode || shapePoints.length < 3) {
      alert("?�역??그려주세?? (마우?��? ?�래그하???�역??그리?�요)");
      return;
    }

    const product = products.find((p) => p.id === shapeEditMode);
    if (!product) return;

    // ?�제 ?�래그한 ?�역???�기 계산 (?�센??기�?)
    const xCoords = shapePoints.map((p) => p.x);
    const yCoords = shapePoints.map((p) => p.y);
    const minX = Math.min(...xCoords);
    const maxX = Math.max(...xCoords);
    const minY = Math.min(...yCoords);
    const maxY = Math.max(...yCoords);
    
    const widthPercent = maxX - minX;
    const heightPercent = maxY - minY;
    
    // 컨테?�너???�제 ?��? ?�기 가?�오�?    const containerWidth = containerRef.current?.getBoundingClientRect().width || 1000;
    const containerHeight = containerRef.current?.getBoundingClientRect().height || 1000;
    
    // ?�제 ?��? ?�기 계산
    const actualWidthPx = (widthPercent / 100) * containerWidth;
    const actualHeightPx = (heightPercent / 100) * containerHeight;
    
    // width?� height�??�제 ?�기??비�??�여 ?�정 (최소 100, ?�절???��????�용)
    const scaledWidth = Math.max(100, Math.round(actualWidthPx * 0.5)); // 0.5 ?��????�용
    const scaledHeight = Math.max(100, Math.round(actualHeightPx * 0.5));

    // SVG path ?�성
    const pathCommands =
      shapePoints
        .map((point, index) => {
          if (index === 0) {
            return `M ${point.x} ${point.y}`;
          }
          return `L ${point.x} ${point.y}`;
        })
        .join(" ") + " Z";

    // 복사??코드 ?�성
    const codeText = `    // Pants - horizontal shape
    if (name.includes('${product.name.substring(
      0,
      3,
    )}') || slug.includes('${product.slug?.substring(0, 5)}')) {
  return {
    path: "${pathCommands}",
    width: ${scaledWidth}, // ?�래그한 ?�역 ?�기 기�? (?�제: ${Math.round(actualWidthPx)}px)
    height: ${scaledHeight}, // ?�래그한 ?�역 ?�기 기�? (?�제: ${Math.round(actualHeightPx)}px)
    viewBox: "0 0 100 100",
  };
}`;

    console.group("?�� 커스?� ?�역 SVG Path");
    console.log(`?�품: ${product.name}`);
    console.log(`??개수: ${shapePoints.length}�?);
    console.log("\n?�성??코드:\n");
    console.log(codeText);
    console.groupEnd();

    // ?�립보드???�동 복사
    try {
      await navigator.clipboard.writeText(codeText);
      alert(
        `??커스?� ?�역 코드가 ?�립보드??복사?�었?�니??\n\n그�?�?붙여?�기(Ctrl+V)?�여 보내주세??`,
      );
    } catch (err) {
      console.error("?�립보드 복사 ?�패:", err);
      alert(
        `커스?� ?�역???�성?�었?�니??\n브라?��? 콘솔(F12)?�서 코드�??�인?�고 복사?�세??`,
      );
    }

    // 초기??    setShapeEditMode(null);
    setShapePoints([]);
    setEditMode(true);
  };

  // ?�역 ?�집 취소
  const cancelShapeEdit = () => {
    setShapeEditMode(null);
    setShapePoints([]);
    setIsDrawing(false);
    setEditMode(true);
  };

  // ?�역 초기??(?�시 그리�?
  const resetShapeEdit = () => {
    setShapePoints([]);
    setIsDrawing(false);
  };

  const copyAllPositionsSQL = () => {
    const sqlStatements = products
      .map((product) => {
        const pos = tempPositions[product.id] || {
          x: product.position_x,
          y: product.position_y,
        };
        return `UPDATE public.lookbook_items li
SET position_x = ${pos.x.toFixed(2)}, position_y = ${pos.y.toFixed(2)}
FROM public.lookbooks lb, public.products p
WHERE li.lookbook_id = lb.id 
  AND li.product_id = p.id
  AND lb.id = '${lookbookId}'
  AND p.slug = '${product.slug}';`;
      })
      .join("\n\n");

    console.group("???�체 ?�치 ?�데?�트 SQL");
    console.log(`?�재 룩북 ID: ${lookbookId}`);
    console.log(`?�목: ${title}`);
    console.log("?�래 SQL??Supabase?�서 ?�행?�세??\n");
    console.log(sqlStatements);
    console.groupEnd();

    navigator.clipboard.writeText(sqlStatements);
    alert(
      `SQL???�립보드??복사?�었?�니??\n\n?�재 룩북: ${title}\n브라?��? 콘솔(F12)?�서???�인?????�습?�다.`,
    );
  };

  return (
    <section className="relative w-full">
      {/* ?�목 �??�집 모드 ?��? */}
      <div className="pt-8 pb-6 text-center">
        <div className="flex flex-col items-center gap-2">
          <h1
            className="text-5xl font-light tracking-[0.1em] text-gray-900"
            style={{ fontFamily: "var(--font-playfair), serif" }}
          >
            BEST CODY
          </h1>
          {/* Male/Female ?�시 */}
          {lookbookIndex !== undefined && (
            <p className="text-sm font-light tracking-wider text-gray-500 uppercase">
              {lookbookIndex === 0 ? "Male" : "Female"}
            </p>
          )}
        </div>
        <div className="flex items-center justify-center gap-4 mt-4">
          {searchParams.get("edit") === "true" && (
            <div className="flex items-center gap-2">
              <Button
                onClick={() => setEditMode(!editMode)}
                variant={editMode ? "default" : "outline"}
                size="sm"
                className="gap-2"
                disabled={!!shapeEditMode}
              >
                <Edit3 className="h-4 w-4" />
                {editMode ? "?�집 �? : "?�집 모드"}
              </Button>
              {editMode && Object.keys(tempPositions).length > 0 && (
                <Button
                  onClick={copyAllPositionsSQL}
                  variant="secondary"
                  size="sm"
                  className="gap-2"
                >
                  <Save className="h-4 w-4" />
                  SQL 복사
                </Button>
              )}
            </div>
          )}
        </div>
        {editMode && (
          <div className="mt-3 flex items-center justify-center gap-3">
            <Button
              type="button"
              onClick={() => setIsolateMode((v) => !v)}
              variant={isolateMode ? "default" : "outline"}
              size="sm"
            >
              {isolateMode ? "?�른 ?�역 보이�? : "?�른 ?�역 ?�기�?}
            </Button>
            <span className="text-xs text-gray-500">?�택 ??방향?�로 미세 ?�동 가??/span>
          </div>
        )}
        {editMode && !shapeEditMode && (
          <div className="mt-0 mb-0 space-y-2">
            <p className="text-sm text-gray-600">
              ?�� ?�품???�래그하???�치�?조정?�세?? 변�???"SQL 복사" 버튼??              ?�릭?�세??
            </p>
            <p className="text-xs font-semibold text-blue-600">
              ?�� ?�재 ?�집 �? {title} (ID: {lookbookId.slice(0, 8)}...)
            </p>
            <p className="text-xs text-gray-500">
              {lookbookIndex === 0 
                ? "??�?번째 룩북 (Male) - ??룩북�??�집?�니?? 
                : lookbookIndex === 1 
                ? "????번째 룩북 (Female) - ??룩북�??�집?�니??
                : "??룩북 ?�집 모드"}
            </p>
          </div>
        )}
        {shapeEditMode && (
          <div className="mt-0 mb-0 space-y-2">
            <p className="text-sm font-semibold text-blue-600">
              ?�� ?�역 ?�집 모드: 마우?��? ?�래그하???�역???�유�?�� 그리?�요
            </p>
            <p className="text-xs text-gray-500">
              {isDrawing
                ? "그리??�?.."
                : `?�재 ${shapePoints.length}개의 ?�이 그려�?}
            </p>
            <div className="flex items-center justify-center gap-2">
              <Button
                onClick={finishShapeEdit}
                variant="default"
                size="sm"
                disabled={shapePoints.length < 3 || isDrawing}
              >
                ?�료
              </Button>
              <Button onClick={resetShapeEdit} variant="secondary" size="sm">
                초기??              </Button>
              <Button onClick={cancelShapeEdit} variant="outline" size="sm">
                취소
              </Button>
            </div>
          </div>
        )}
      </div>

      {/* 룩북 ?��?지 - ?�체 ?�면, ?�딩 ?�음 */}
      <div
        ref={containerRef}
        className="group relative mx-auto w-full"
        onMouseDown={(e) => {
          // ?�품 ?�역?�서 ?�작???�벤?�는 무시
          if (!shapeEditMode || (e.target as HTMLElement).closest('[data-product-id]')) {
            return;
          }
          startDrawing(e);
        }}
        onMouseMove={shapeEditMode ? (e) => {
          // ?�품 ?�역?�서 ?�작???�벤?�는 무시
          if ((e.target as HTMLElement).closest('[data-product-id]')) {
            return;
          }
          continueDrawing(e);
        } : undefined}
        onMouseUp={shapeEditMode ? (e) => {
          // ?�품 ?�역?�서 ?�작???�벤?�는 무시
          if ((e.target as HTMLElement).closest('[data-product-id]')) {
            return;
          }
          stopDrawing(e);
        } : undefined}
        onMouseLeave={shapeEditMode ? stopDrawing : undefined}
        style={{ cursor: shapeEditMode ? "crosshair" : "default" }}
      >
        <div 
          className="relative w-full" 
          style={{ 
            minHeight: "60vh",
            maxHeight: "65vh",
            // pointerEvents???�거 - ?�품 ?�역???�릭 가?�하?�록
          }}
        >
          <Image
            src={imageUrl}
            alt={title}
            fill
            className="object-contain"
            sizes="100vw"
            priority
            style={{ pointerEvents: "none" }}
          />

          {/* ?�역 ?�집 �??�작?�과 ?�재???�시 */}
          {shapeEditMode && shapePoints.length > 0 && (
            <>
              {/* ?�작???�시 */}
              <div
                className="absolute z-50"
                style={{
                  left: `${shapePoints[0].x}%`,
                  top: `${shapePoints[0].y}%`,
                  transform: "translate(-50%, -50%)",
                }}
              >
                <div className="h-4 w-4 rounded-full bg-green-500 border-2 border-white shadow-lg" />
              </div>

              {/* ?�재 마�?�????�시 (그리??중일 ?�만) */}
              {isDrawing && shapePoints.length > 1 && (
                <div
                  className="absolute z-50"
                  style={{
                    left: `${shapePoints[shapePoints.length - 1].x}%`,
                    top: `${shapePoints[shapePoints.length - 1].y}%`,
                    transform: "translate(-50%, -50%)",
                  }}
                >
                  <div className="h-3 w-3 rounded-full bg-blue-500 border-2 border-white shadow-lg animate-pulse" />
                </div>
              )}
            </>
          )}

          {/* ?�역 ?�집 �???그리�?*/}
          {shapeEditMode && shapePoints.length > 1 && (
            <svg className="absolute inset-0 w-full h-full pointer-events-none z-40">
              <path
                d={shapePoints
                  .map((p, i) =>
                    i === 0 ? `M ${p.x} ${p.y}` : `L ${p.x} ${p.y}`,
                  )
                  .join(" ")}
                fill="none"
                stroke={
                  isDrawing
                    ? "rgba(59, 130, 246, 1)"
                    : "rgba(59, 130, 246, 0.8)"
                }
                strokeWidth={isDrawing ? "3" : "2"}
                strokeLinecap="round"
                strokeLinejoin="round"
              />
              {/* 마�?�??�에??�??�으�??�결 (?�기 미리보기) - 그리??중이 ?�닐 ?�만 */}
              {!isDrawing && shapePoints.length >= 3 && (
                <line
                  x1={`${shapePoints[shapePoints.length - 1].x}%`}
                  y1={`${shapePoints[shapePoints.length - 1].y}%`}
                  x2={`${shapePoints[0].x}%`}
                  y2={`${shapePoints[0].y}%`}
                  stroke="rgba(59, 130, 246, 0.4)"
                  strokeWidth="2"
                  strokeDasharray="5,5"
                />
              )}
              {/* ?�역 채우�?(그리??중이 ?�닐 ?�만) */}
              {!isDrawing && shapePoints.length >= 3 && (
                <path
                  d={
                    shapePoints
                      .map((p, i) =>
                        i === 0 ? `M ${p.x} ${p.y}` : `L ${p.x} ${p.y}`,
                      )
                      .join(" ") + " Z"
                  }
                  fill="rgba(59, 130, 246, 0.15)"
                  stroke="none"
                />
              )}
            </svg>
          )}

          {/* ?�품 ?�역??*/}
          {products.map((product) => {
            const productHref = product.slug
              ? `/products/${product.slug}`
              : `/products/${product.id}`;
            const isHovered = hoveredProduct === product.id;
            const isDragging = draggedProduct === product.id;
            const isSelected = selectedProductId === product.id; // ?�택???�품?��?

            // ?�시 ?�치 ?�는 기본 ?�치
            const currentPos = tempPositions[product.id] || {
              x: product.position_x,
              y: product.position_y,
            };

            // ?�품�?맞춤 모양 가?�오�?            const shape = getProductShape(product.name, product.slug);
            const nameLower = product.name.toLowerCase();
            const slugLower = product.slug?.toLowerCase() || "";
            const isLaptopArea =
              nameLower.includes("?�트�?) 
              slugLower.includes("laptop") 
              slugLower.includes("notebook") 
              slugLower.includes("premium-laptop") 
              slugLower.includes("premium-notebook");

            return (
              <div
                key={product.id}
                className="absolute"
                style={{
                  left: `${currentPos.x}%`,
                  top: `${currentPos.y}%`,
                  transform: "translate(-50%, -50%)",
                  zIndex: isDragging ? 50 : (isLaptopArea ? 20 : 30), // ?�트�??�역?� ?�선?�위�???�� ?�른 ?�역????? ?�도�?                  userSelect: "none",
                  pointerEvents: "auto", // ?�집 모드?� 비편�?모드 모두 ?�성??                }}
                data-product-area="true"
              >
                {/* ?�집 모드???�는 ?�래�?가?? ?�닐 ?�는 링크 */}
                {editMode ? (
                  <div
                    className="relative"
                    style={{
                      width: `${shape.width}px`,
                      height: `${shape.height}px`,
                      pointerEvents: "none", // 컨테?�너??비활?�화
                      opacity: isolateMode ? (isSelected ? 1 : 0) : (selectedProductId && !isSelected ? 0.3 : 1),
                      display: isolateMode && !isSelected ? "none" : "block",
                    }}
                    onClick={(e) => {
                      e.stopPropagation();
                    }}
                  >
                    {/* ?�역 경계???�시 (?�집 모드) - ?�택???�품�??�래�?가??*/}
                    {isSelected && (
                      <svg
                        className="absolute inset-0 w-full h-full"
                        viewBox={
                          shape.viewBox || `0 0 ${shape.width} ${shape.height}`
                        }
                        preserveAspectRatio="none"
                        style={{ 
                          overflow: "visible", 
                          pointerEvents: "auto", // ?�택???�품�??�성??                        }}
                      >
                        {/* ?�역 ?�곽??- ?�제 ?�릭 ?�역 */}
                        <path
                          d={shape.path}
                          fill={
                            isDragging
                              ? "rgba(59, 130, 246, 0.2)"
                              : "rgba(34, 197, 94, 0.15)" // ?�택?? 초록??                          }
                          stroke={
                            isDragging
                              ? "rgba(59, 130, 246, 1)"
                              : "rgba(34, 197, 94, 1)" // ?�택?? 초록??                          }
                          strokeWidth={3}
                          strokeDasharray={isDragging ? "0" : "8 4"}
                          className="transition-all duration-200"
                          style={{
                            cursor: isDragging ? "grabbing" : "grab",
                            pointerEvents: "fill",
                          }}
                          onMouseDown={(e) => {
                            e.stopPropagation();
                            handleDragStart(product.id);
                          }}
                        />
                      </svg>
                    )}
                    
                    {/* ?�택?��? ?��? ?�품?� 가?�적 ?�시�?(?�릭 불�?) */}
                    {!isSelected && (
                      <svg
                        className="absolute inset-0 w-full h-full"
                        viewBox={
                          shape.viewBox || `0 0 ${shape.width} ${shape.height}`
                        }
                        preserveAspectRatio="none"
                        style={{ 
                          overflow: "visible", 
                          pointerEvents: "none", // ?�전??비활?�화
                        }}
                      >
                        <path
                          d={shape.path}
                          fill="rgba(59, 130, 246, 0.1)"
                          stroke="rgba(59, 130, 246, 0.5)"
                          strokeWidth={2}
                          strokeDasharray="8 4"
                          className="transition-all duration-200"
                          style={{
                            pointerEvents: "none", // ?�전??비활?�화
                          }}
                        />
                      </svg>
                    )}

                    {/* ?�집 모드 ?�시 */}
                    <div 
                      className="absolute inset-0 flex flex-col items-center justify-center gap-2"
                      style={{ 
                        pointerEvents: "none", // 컨테?�너??비활?�화
                        zIndex: 100, // 버튼??최상?�로
                      }}
                    >
                      <div className={`rounded-lg px-3 py-1 text-xs font-semibold text-white shadow-lg ${
                        isSelected ? 'bg-green-500' : 'bg-blue-500'
                      }`}>
                        {product.name}
                      </div>
                      <div 
                        className="flex gap-2" 
                        style={{ 
                          pointerEvents: "auto", // 버튼�??�성??                          zIndex: 101, // 버튼??최상?�로
                        }}
                      >
                        {!isSelected ? (
                          <Button
                            onClick={(e) => {
                              e.stopPropagation();
                              handleSelectProduct(product.id);
                            }}
                            size="sm"
                            variant="default"
                            className="bg-green-600 hover:bg-green-700 text-white text-xs h-7"
                          >
                            ?�택
                          </Button>
                        ) : (
                          <Button
                            onClick={(e) => {
                              e.stopPropagation();
                              handleCompleteSelection();
                            }}
                            size="sm"
                            variant="default"
                            className="bg-blue-600 hover:bg-blue-700 text-white text-xs h-7"
                          >
                            ?�료
                          </Button>
                        )}
                        <Button
                          onClick={(e) => {
                            e.stopPropagation();
                            startShapeEdit(product.id);
                          }}
                          size="sm"
                          variant="outline"
                          className="bg-white text-xs h-7"
                        >
                          ?�역 ?�집
                        </Button>
                      </div>
                    </div>
                    {/* ?�치 ?�시 */}
                    <div 
                      className="absolute -bottom-6 left-1/2 -translate-x-1/2 whitespace-nowrap rounded bg-black/80 px-2 py-1 text-xs text-white"
                      style={{ pointerEvents: "none" }} // ?�래그�? 방해?��? ?�도�?                    >
                      {currentPos.x.toFixed(1)}%, {currentPos.y.toFixed(1)}%
                    </div>
                  </div>
                ) : (
                  <div
                    className="relative"
                    style={{
                      width: `${shape.width}px`,
                      height: `${shape.height}px`,
                      pointerEvents: "none", // 컨테?�너???�벤??차단 ????                    }}
                    data-product-id={product.id}
                  >
                    {/* SVG�?hover ?�역�??�의 */}
                    <svg
                      className="absolute inset-0 w-full h-full"
                      viewBox={
                        shape.viewBox || `0 0 ${shape.width} ${shape.height}`
                      }
                      preserveAspectRatio="none"
                      style={{
                        overflow: "visible",
                        pointerEvents: "none", // 경계 ?�자 ?�체가 ?�닌 path�??�벤??처리
                      }}
                    >
                      {/* ?�명??hover 감�? ?�역 (비편�?모드?�서???�각???�곽???�거) */}
                      <path
                        d={shape.path}
                        fill="rgba(0, 0, 0, 0.01)"
                        stroke="transparent"
                        strokeWidth="0"
                        style={{
                          pointerEvents: "fill",
                          cursor: "pointer",
                        }}
                        onMouseEnter={(e) => {
                          e.stopPropagation();
                          setHoveredProduct(product.id);
                        }}
                        onMouseLeave={(e) => {
                          e.stopPropagation();
                          // 중앙 ?�품???�닌 경우?�만 즉시 ?�제
                          const slug = product.slug?.toLowerCase() || "";
                          const name = product.name.toLowerCase();
                          const isCenterProduct = 
                              slug.includes("overs") || slug.includes("hoodie") 
 ||
      slug.includes("wireless-earbuds") || slug.includes("airpods") || slug.includes("earbuds") 
 ||
      slug.includes("class") || slug.includes("sneakers") || slug.includes("shoes") 
 ||
      slug.includes("laptop") ||
      slug.includes("chino") || slug.includes("pants") 
                          if (!isCenterProduct) {
                            setHoveredProduct(null);
                          }
                        }}
                        onClick={(e) => {
                          e.stopPropagation();
                          window.location.href = productHref;
                        }}
                      />
                    </svg>
                  </div>
                )}

                {/* ?�버 ???�품 ?�보 카드 - ?�플???�자??(?�집 모드가 ?�닐 ?�만) */}
                {!editMode && (
                  <AnimatePresence>
                    {isHovered &&
                      (() => {
                        // ?�품 카드 ?�치 결정 (slug 기반?�로 ?�확?�게 매칭)
                        const slug = product.slug?.toLowerCase() || "";
                        const name = product.name.toLowerCase();

                        // ?�드?��? 무선?�어?��? ?�면 중앙???�시
                        const isHoodie =

                          slug.includes("overs") 
 ||
      slug.includes("hoodie");
                        const isEarbuds =
                          slug.includes("wireless-earbuds") 
 ||
      slug.includes("airpods") ||
      slug.includes("earbuds") 
                        // ?�니커즈?� ?�트북도 ?�면 중앙???�시
                        const isSneakers =
                          slug.includes("class") || // ?�니커즈
                          slug.includes("sneakers") 
 ||
      slug.includes("shoes") 
                        const isLaptop =
                          slug.includes("laptop") "?�트�?);
                        
                        // 치노?�츠???�면 중앙???�시
                        const isChinoPants =
                          slug.includes("chino") 
 ||
      slug.includes("pants") 
                        // 중앙???�시???�품??                        const isCenterProduct = isHoodie || isEarbuds || isSneakers || isLaptop || isChinoPants;

                        const shouldShowAbove = false; // ???�상 ?�용?��? ?�음 (모두 중앙???�시)

                        // ?�드?? 무선?�어?? ?�니커즈, ?�트북�? ?�면 중앙??고정
                        if (isCenterProduct) {
                          return (
                            <motion.div
                              initial={{ opacity: 0, scale: 0.95 }}
                              animate={{ opacity: 1, scale: 1 }}
                              exit={{ opacity: 0, scale: 0.95 }}
                              transition={{ duration: 0.2 }}
                              className="fixed left-1/2 top-1/2 z-50 w-72 -translate-x-1/2 -translate-y-1/2"
                              style={{ pointerEvents: "auto" }}
                              onMouseEnter={() => setHoveredProduct(product.id)}
                              onMouseLeave={() => {
                                // ?�간??지?�을 ?�어 ?�품 ?�역?�로 ?�아가??경우�?고려
                                setTimeout(() => {
                                  const hoveredElement = document.elementFromPoint(
                                    window.mouseX || 0,
                                    window.mouseY || 0
                                  );
                                  const isOnProductArea = hoveredElement?.closest(`[data-product-id="${product.id}"]`);
                                  const isOnCard = hoveredElement?.closest('.fixed.left-1\\/2');
                                  if (!isOnProductArea && !isOnCard) {
                                    setHoveredProduct(null);
                                  }
                                }, 100);
                              }}
                            >
                              <Link href={productHref}>
                                <div className="overflow-hidden rounded-xl bg-white shadow-2xl transition-transform hover:scale-[1.02]">
                                  {/* ?�품 ?��?지 */}
                                  {product.image_url && (
                                    <div className="relative aspect-square w-full">
                                      <Image
                                        src={product.image_url}
                                        alt={product.name}
                                        fill
                                        className="object-cover"
                                        sizes="288px"
                                      />
                                    </div>
                                  )}

                                  {/* ?�품 ?�보 */}
                                  <div className="space-y-2 p-4">
                                    <h3 className="line-clamp-2 text-sm font-semibold text-gray-900">
                                      {product.name}
                                    </h3>
                                    <div className="flex items-center justify-between pt-1">
                                      <span className="text-lg font-bold text-gray-900">
                                        {formatCurrency(
                                          product.price,
                                          product.currency,
                                        )}
                                      </span>
                                      <Button size="sm" className="gap-1.5">
                                        <ShoppingCart className="h-3.5 w-3.5" />
                                        <span>?�기</span>
                                      </Button>
                                    </div>
                                  </div>
                                </div>
                              </Link>
                            </motion.div>
                          );
                        }

                        return (
                          <motion.div
                            initial={{
                              opacity: 0,
                              y: shouldShowAbove ? -10 : 10,
                              scale: 0.95,
                            }}
                            animate={{ opacity: 1, y: 0, scale: 1 }}
                            exit={{
                              opacity: 0,
                              y: shouldShowAbove ? -10 : 10,
                              scale: 0.95,
                            }}
                            transition={{ duration: 0.2 }}
                            className={`absolute left-1/2 z-50 w-72 -translate-x-1/2 ${
                              shouldShowAbove
                                ? "bottom-full mb-4"
                                : "top-full mt-4"
                            }`}
                            style={{ pointerEvents: "auto" }}
                          >
                            <Link href={productHref}>
                              <div className="overflow-hidden rounded-xl bg-white shadow-2xl transition-transform hover:scale-[1.02]">
                                {/* ?�품 ?��?지 */}
                                {product.image_url && (
                                  <div className="relative aspect-square w-full">
                                    <Image
                                      src={product.image_url}
                                      alt={product.name}
                                      fill
                                      className="object-cover"
                                      sizes="288px"
                                    />
                                  </div>
                                )}

                                {/* ?�품 ?�보 */}
                                <div className="space-y-2 p-4">
                                  <h3 className="line-clamp-2 text-sm font-semibold text-gray-900">
                                    {product.name}
                                  </h3>
                                  <div className="flex items-center justify-between pt-1">
                                    <span className="text-lg font-bold text-gray-900">
                                      {formatCurrency(
                                        product.price,
                                        product.currency,
                                      )}
                                    </span>
                                    <Button size="sm" className="gap-1.5">
                                      <ShoppingCart className="h-3.5 w-3.5" />
                                      <span>?�기</span>
                                    </Button>
                                  </div>
                                </div>
                              </div>
                            </Link>
                          </motion.div>
                        );
                      })()}
                  </AnimatePresence>
                )}
              </div>
            );
          })}
        </div>

        {/* ?�내 ?�스???�거 - 미니멀 ?�자??*/}
      </div>

      {/* ?�디케?�터 (?��?지 ?�래, ?�명 ?? */}
      {currentIndex !== undefined && totalCount !== undefined && totalCount > 1 && onIndicatorClick && (
        <div className="flex justify-center items-center gap-2 py-4">
          {Array.from({ length: totalCount }).map((_, index) => (
            <button
              key={index}
              onClick={() => onIndicatorClick(index)}
              className={`h-2 rounded-full transition-all duration-300 ${
                index === currentIndex
                  ? "w-8 bg-primary"
                  : "w-2 bg-muted-foreground/40 hover:bg-muted-foreground/60"
              }`}
              aria-label={`${index + 1}번째 룩북?�로 ?�동`}
            />
          ))}
        </div>
      )}

      {/* ?�션 ?�문가 ?�명 ?�션 */}
      <div className="mx-auto max-w-4xl px-6 pt-12 pb-8">
        <div className="text-center space-y-4">
          <h2 
            className="text-2xl font-light tracking-wide text-gray-700"
            style={{ fontFamily: "var(--font-playfair), serif" }}
          >
            Style Insight
          </h2>
          <p className="text-base leading-relaxed text-gray-600 max-w-2xl mx-auto">
            {getFashionDescription(title, imageUrl)}
          </p>
        </div>
      </div>

      {/* ?�단 ?�품 목록 ?�거 */}
    </section>
  );
}

// ?�션 ?�문가 ?�명 ?�성 ?�수
function getFashionDescription(title: string, imageUrl: string): string {
  // ?��?지 URL 기반?�로 ?�명 결정
  if (imageUrl.includes('hero-look') || imageUrl.includes('lookbooks/hero')) {
    return "This versatile ensemble combines comfort and sophistication, perfect for the modern professional. The layered approach with premium outerwear creates depth while maintaining a clean, polished aesthetic. Each piece is carefully curated to transition seamlessly from day to evening.";
  }
  
  if (imageUrl.includes('111.png') || imageUrl.includes('/11.png')) {
    return "A contemporary streetwear-inspired look that balances casual comfort with refined details. The cohesive color palette and thoughtful layering demonstrate how mixing textures and proportions can create a distinctive personal style statement.";
  }
  
  // 기본 ?�명
  return "This carefully curated look showcases the art of effortless style. Each piece has been selected to work harmoniously together, creating a cohesive ensemble that speaks to modern sophistication and individual expression. The combination of premium materials and thoughtful design details elevates this look beyond the ordinary.";
}
